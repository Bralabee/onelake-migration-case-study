###############################################
# OneLake Migration Project Environment Template
# Copy to .env and fill in required values.
# Lines beginning with '#' are comments.
###############################################

########## Azure AD / Microsoft Entra (Authentication) ##########
TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx         # Directory (tenant) ID
CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx         # App registration (client) ID
CLIENT_SECRET=your_client_secret_here                  # Client secret (store securely; never commit real value)

########## Fabric / OneLake Configuration ##########
FABRIC_WORKSPACE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx  # Fabric workspace GUID
FABRIC_LAKEHOUSE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx  # Lakehouse GUID inside the workspace
ONELAKE_BASE_PATH=/Files/migration_uploads               # Base path under Lakehouse Files (leading / optional)
DELTA_TABLE_NAME=migration_audit_log                     # (Optional) Delta table name for logging, if used

########## SharePoint Source Configuration ##########
SP_HOSTNAME=yourtenant.sharepoint.com                 # e.g. contoso.sharepoint.com
SP_SITE_PATH=/sites/YourProjectSite                   # Site relative path starting with /sites
SP_LIBRARY_NAME=Shared Documents                      # Document Library display name (encode spaces as-is)
SP_START_FOLDER=/                                     # Subfolder within the library to start ("/" for root)

########## Local Paths ##########
LOCAL_DOWNLOAD_PATH=./data/downloads                  # Local folder to store downloaded files

########## Access Tokens (Optional Overrides) ##########
# The code normally acquires tokens automatically via MSAL.
# You may pre-populate a Fabric access token for testing short-lived sessions.
FABRIC_ACCESS_TOKEN=                                  # Optional manual Fabric token (will override auto retrieval if set)
ACCESS_TOKEN=                                         # Optional generic Graph token override

########## Performance / Concurrency Tuning ##########
# Adjust only if you need to tune migration performance. Leave defaults if unsure.
MAX_CONCURRENT_UPLOADS=8                              # Parallel uploads for turbo migrator
UPLOAD_CHUNK_SIZE_MB=4                                # Chunk size in MB for append operations
RETRY_MAX_ATTEMPTS=5                                  # Max retry attempts for transient HTTP errors
RETRY_BASE_DELAY_SECONDS=1.0                          # Base delay for exponential backoff

########## Logging / Diagnostics ##########
LOG_LEVEL=INFO                                        # DEBUG, INFO, WARNING, ERROR
PROGRESS_REFRESH_SECONDS=5                            # Interval the dashboards refresh progress JSON

########## Safety Toggles ##########
DRY_RUN=false                                         # If true, enumerate and stage but do not upload
STOP_ON_FIRST_ERROR=false                             # If true, abort on first failed file

########## Reserved / Future ##########
# Add future variables below this line.

