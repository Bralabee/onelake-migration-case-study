#############################################################
# Makefile_organized (Legacy Compatibility Layer)           #
# This file is intentionally slim to prevent drift.         #
# All logic & variables live in primary 'Makefile'.          #
# Usage here simply delegates to the main Makefile targets.  #
#############################################################

# Allow overriding path to primary Makefile if relocated
PRIMARY_MAKEFILE ?= Makefile

.PHONY: help migrate-prod migrate-turbo migrate-working migrate-retry migrate-reconcile migrate-noop migrate-test-run \
	env-create env-update env-clean env-setup env-activate download test run status vars \
	clear-cache refresh cache-status run-turbo run-turbo-conservative run-turbo-normal run-turbo-fast test-turbo compare-speeds \
	dashboard dashboard-enhanced dashboard-custom analyze-logs analyze-logs-chart monitor-progress monitor-cache monitor-all \
	fabric-setup fabric-analyze fabric-migrate fabric-migrate-turbo fabric-migrate-turbo-conservative fabric-migrate-resume \
	fabric-migrate-turbo-resume fabric-test fabric-test-single fabric-create-directories fabric-get-token fabric-create-directories-api \
	fabric-migrate-azcopy fabric-migrate-azcopy-dryrun fabric-setup-fileexplorer fabric-help clean reorganize reorganize-dryrun

%:
	@echo "[Makefile_organized] Delegating target '$@' to primary $(PRIMARY_MAKEFILE)"
	@$(MAKE) -f $(PRIMARY_MAKEFILE) $@

help:
	@$(MAKE) -f $(PRIMARY_MAKEFILE) help
